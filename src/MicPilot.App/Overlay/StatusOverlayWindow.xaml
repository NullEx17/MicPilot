<Window x:Class="MicPilot.App.Overlay.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicPilot Status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="False">
    <Border x:Name="Root"
            Opacity="0"
            Background="#E60C0C0E"
            BorderBrush="#292C32"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="StateIcon"
                   Width="28"
                   Height="28"
                   Stretch="Uniform"
                   Margin="0,0,8,0" />
            <Ellipse x:Name="StateDot"
                     Width="7"
                     Height="7"
                     Fill="#32DC5F"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="StatusLabel"
                       Text="ON"
                       FontSize="12"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource AppFontFamily}"
                       Foreground="#F5F5F5"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
