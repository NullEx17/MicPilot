<UserControl x:Class="MicPilot.App.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Margin="32,40">

            <Image Source="pack://application:,,,/MicPilot;component/Assets/app/micpilot_on_64x64.png"
                   Width="64"
                   Height="64"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />

            <TextBlock Text="MicPilot"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock Text="No more Push-to-Talk."
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,10" />
            <TextBlock Text="by NullEx17"
                       Style="{StaticResource MutedTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock Text="v1.0.0"
                       Style="{StaticResource DimTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,22" />

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,0,24,18" />

            <Button Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8" Padding="12,10" Click="Website_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#1A1C21"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="{StaticResource GlobeGeometry}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Website" FontWeight="SemiBold" />
                        <TextBlock Text="nullex17.me" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8" Padding="12,10" Click="Discord_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#1A1C21"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/MicPilot;component/Assets/about/discord.png"
                               Width="18" Height="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Discord" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiscordHandle" Text="@NullEx17" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource CardButtonStyle}" Padding="12,10" Click="GitHub_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#1A1C21"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/MicPilot;component/Assets/about/github.png"
                               Width="18" Height="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="GitHub" FontWeight="SemiBold" />
                        <TextBlock Text="github.com/NullEx17" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,18,24,16" />

            <TextBlock Text="© 2026 NullEx17"
                       Style="{StaticResource DimTextStyle}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
