<UserControl x:Class="MicPilot.App.Views.Pages.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MicPilot.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,8">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,18" />

                <TextBlock Text="GENERAL" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="4,2">
                    <StackPanel>
                        <Grid Margin="12,10">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Minimize to tray" FontWeight="SemiBold" />
                                <TextBlock Text="Closing the window hides MicPilot in the system tray."
                                           Style="{StaticResource DimTextStyle}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding MinimizeToTray}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <Grid Margin="12,10">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Start minimized" FontWeight="SemiBold" />
                                <TextBlock Text="Launch in the tray instead of showing the window."
                                           Style="{StaticResource DimTextStyle}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimized}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="AUDIO" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Physical microphone" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxDarkStyle}"
                                  Margin="0,0,0,14" />
                        <TextBlock Text="Virtual microphone" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding VirtualMicrophoneName}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="MicPilot writes to" Style="{StaticResource DimTextStyle}" />
                        <TextBlock Text="{Binding MicPilotOutputName}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="HOTKEYS" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Global hotkey" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                        <controls:HotkeyCaptureBox Hotkey="{Binding GlobalHotkey, Mode=TwoWay}" Margin="0,0,0,14" />
                        <TextBlock Text="Hotkey mode" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                  SelectedItem="{Binding HotkeyMode}"
                                  Style="{StaticResource ComboBoxDarkStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="OVERLAY" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="4,2">
                    <StackPanel>
                        <Grid Margin="12,10">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Show overlay" FontWeight="SemiBold" />
                                <TextBlock Text="Brief on-screen indicator when the game mic changes."
                                           Style="{StaticResource DimTextStyle}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding OverlayEnabled}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <Grid Margin="12,10">
                            <TextBlock Text="Position" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PositionOptions}"
                                      SelectedItem="{Binding OverlayPosition}"
                                      Style="{StaticResource ComboBoxDarkStyle}"
                                      Width="160"
                                      HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <Grid Margin="12,10">
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="Display duration" FontWeight="SemiBold" />
                                <TextBlock Text="Seconds before the overlay fades out."
                                           Style="{StaticResource DimTextStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox Text="{Binding OverlayDurationSeconds}"
                                     Style="{StaticResource TextBoxDarkStyle}"
                                     Width="72"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,0" />
                        <Grid Margin="12,10">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="Always visible" FontWeight="SemiBold" />
                                <TextBlock Text="Keep the overlay on screen instead of fading."
                                           Style="{StaticResource DimTextStyle}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding OverlayAlwaysVisible}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="4,2">
                    <Grid Margin="12,10">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Text="Enable notifications" FontWeight="SemiBold" />
                            <TextBlock Text="Show Windows tray notifications for important events."
                                       Style="{StaticResource DimTextStyle}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding NotificationsEnabled}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="STARTUP" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="4,2">
                    <Grid Margin="12,10">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Text="Launch MicPilot automatically when Windows starts."
                                       Style="{StaticResource DimTextStyle}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding StartWithWindows}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Exclusive fullscreen may hide overlays. Prefer borderless fullscreen."
                                   Style="{StaticResource DimTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open Logs" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OpenLogs_Click" />
                            <Button Content="Copy Diagnostics" Style="{StaticResource SecondaryButtonStyle}" Click="CopyDiagnostics_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Button Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Click="Save_Click" />
        </Border>
    </Grid>
</UserControl>
