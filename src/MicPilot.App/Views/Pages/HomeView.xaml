<UserControl x:Class="MicPilot.App.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MicPilot.App.Converters">
    <UserControl.Resources>
        <conv:LevelBarConverter x:Key="LevelBarConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="LedBar" TargetType="Border">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,20">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,16"
                    Padding="16"
                    Visibility="{Binding ShowSetupTip, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="IMPORTANT" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" FontSize="13">
                        Set your game's microphone/input device to
                    </TextBlock>
                    <TextBlock Text="CABLE Output (VB-Audio Virtual Cable)"
                               FontWeight="SemiBold"
                               Margin="0,4,0,6" />
                    <TextBlock Text="Discord can continue using your normal physical microphone."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Audio Settings"
                                Command="{Binding OpenAudioSettingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="Got it"
                                Command="{Binding DismissSetupTipCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource SectionTitleStyle}" />
            <Button Command="{Binding OpenProfilesCommand}"
                    Style="{StaticResource CardButtonStyle}"
                    Margin="0,0,0,16"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="#171717" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,12,0">
                        <Grid>
                            <Path Data="{StaticResource GameGeometry}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding HasActiveProfileIcon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image Source="{Binding ActiveProfileIcon}" Width="22" Height="22" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasActiveProfileIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveProfileName}" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GameRunningText}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="2" Data="{StaticResource ChevronGeometry}" Width="12" Height="12"
                          Stretch="Uniform" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <TextBlock Text="GAME MIC" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,16" Padding="22,20"
                    Cursor="Hand" MouseLeftButtonUp="GameMicCard_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="pack://application:,,,/MicPilot;component/Assets/overlay/micpilot_overlay_muted_64x64.png" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameMicState}" Value="On">
                                        <Setter Property="Source" Value="pack://application:,,,/MicPilot;component/Assets/overlay/micpilot_overlay_on_64x64.png" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameMicStateText}" FontSize="32" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOffBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameMicState}" Value="On">
                                            <Setter Property="Foreground" Value="{StaticResource StatusOnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding GameMicHintText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding ActiveProfileHotkey}"
                            Command="{Binding OpenSettingsCommand}" Style="{StaticResource KeyCapStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="AUDIO ROUTING" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Microphone (Input)" Style="{StaticResource DimTextStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding InputDeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=0}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=1}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=2}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=3}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=4}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=5}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=6}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=7}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=8}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=9}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=10}" />
                            <Border Style="{StaticResource LedBar}" Background="{Binding InputLevel, Converter={StaticResource LevelBarConverter}, ConverterParameter=11}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Virtual Microphone" Style="{StaticResource DimTextStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding VirtualOutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource StatusMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AudioEngineRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Audio Engine" Style="{StaticResource DimTextStyle}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding AudioEngineStatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,0,18,0" />

                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource StatusOffBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VirtualDeviceAvailable}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Virtual Mic" Style="{StaticResource DimTextStyle}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding VirtualDeviceStatusText}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DimTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,12,0,0"
                        Visibility="{Binding ShowRecoveryActions, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Retry" Command="{Binding RetryAudioCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Audio Settings" Command="{Binding OpenAudioSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
