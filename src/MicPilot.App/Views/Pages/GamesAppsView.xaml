<UserControl x:Class="MicPilot.App.Views.Pages.GamesAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MicPilot.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Games &amp; Apps" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Choose which applications MicPilot controls."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Content="+  Add Game or App"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="6">
            <ListBox x:Name="ProfileList"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12,10"
                                            Margin="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A1C21" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A1D24" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="7"
                                    Background="#1A1C21"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Path Data="{StaticResource GameGeometry}"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Fill="{StaticResource TextMutedBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <Image Source="{Binding Icon}"
                                           Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource StatusMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RunningText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="#1A1C21"
                                    BorderBrush="#3A3D44"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Hotkey}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>

                            <Button Grid.Column="3"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Edit"
                                    Click="Edit_Click"
                                    Tag="{Binding}">
                                <Path Data="{StaticResource EditGeometry}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="{StaticResource TextMutedBrush}" />
                            </Button>
                            <Button Grid.Column="4"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Delete"
                                    Click="Delete_Click"
                                    Tag="{Binding}">
                                <Path Data="{StaticResource TrashGeometry}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="{StaticResource TextMutedBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="2"
                Content="Save"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                MinWidth="96"
                Click="Save_Click" />
    </Grid>
</UserControl>
