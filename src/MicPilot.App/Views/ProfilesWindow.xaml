<Window x:Class="MicPilot.App.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicPilot.App.Controls"
        Title="Games &amp; Apps"
        Width="620"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3"
                   Text="GAMES &amp; APPS"
                   Style="{StaticResource SectionTitleStyle}"
                   FontSize="13"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10" Orientation="Horizontal">
                    <Button Content="+ Add Game or App"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            Margin="0,0,6,0" />
                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Name"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasSelection}"
                         Margin="0,0,0,12"
                         Padding="8,6"
                         Background="{StaticResource SurfaceRaisedBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" />

                <TextBlock Text="Executable"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SelectedProfile.ProcessName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelection}"
                             Padding="8,6"
                             Background="{StaticResource SurfaceRaisedBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" />
                    <Button Grid.Column="2"
                            Content="Browse"
                            Command="{Binding BrowseProcessCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6" />
                </Grid>

                <TextBlock Text="Hotkey"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <controls:HotkeyCaptureBox Hotkey="{Binding SelectedProfile.Hotkey, Mode=TwoWay}"
                                           IsEnabled="{Binding HasSelection}"
                                           Margin="0,0,0,12" />

                <TextBlock Text="Mode"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ModeOptions}"
                          SelectedItem="{Binding SelectedProfile.Mode}"
                          IsEnabled="{Binding HasSelection}"
                          Margin="0,0,0,12"
                          Padding="8,6"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextBrush}"
                          BorderBrush="{StaticResource BorderBrush}" />

                <CheckBox Content="Enabled"
                          IsChecked="{Binding SelectedProfile.Enabled}"
                          IsEnabled="{Binding HasSelection}"
                          Margin="0,0,0,8"
                          Foreground="{StaticResource TextBrush}" />

                <CheckBox Content="Auto-activate when process starts"
                          IsChecked="{Binding SelectedProfile.AutoActivate}"
                          IsEnabled="{Binding HasSelection}"
                          Margin="0,0,0,14"
                          Foreground="{StaticResource TextBrush}" />

                <Button Content="Set as Active Profile"
                        Command="{Binding SetActiveCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Grid.ColumnSpan="3"
                Content="Save"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,14,0,0"
                Click="Save_Click" />
    </Grid>
</Window>
