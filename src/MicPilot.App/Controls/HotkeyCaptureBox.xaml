<UserControl x:Class="MicPilot.App.Controls.HotkeyCaptureBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="#3A3D44"
            BorderThickness="1"
            CornerRadius="7"
            Padding="10,8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DisplayText"
                       Text="{Binding Hotkey, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="CapturePrompt"
                       Text="Press your desired key combination…"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <Button x:Name="ChangeButton"
                    Grid.Column="1"
                    Content="Change"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,4"
                    Margin="8,0,0,0"
                    Click="Change_Click" />

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,4"
                    Margin="8,0,0,0"
                    Visibility="Collapsed"
                    Click="Cancel_Click" />
        </Grid>
    </Border>
</UserControl>
