<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

    <Color x:Key="BackgroundColor">#050506</Color>
    <Color x:Key="SecondaryBackgroundColor">#0C0C0E</Color>
    <Color x:Key="SurfaceColor">#121212</Color>
    <Color x:Key="SurfaceRaisedColor">#171717</Color>
    <Color x:Key="SidebarColor">#0A0A0B</Color>
    <Color x:Key="TitleBarColor">#050506</Color>
    <Color x:Key="BorderColor">#242424</Color>
    <Color x:Key="BorderStrongColor">#2E2E2E</Color>
    <Color x:Key="TextColor">#F5F5F5</Color>
    <Color x:Key="TextMutedColor">#9B9BA0</Color>
    <Color x:Key="TextDimColor">#6F7278</Color>
    <Color x:Key="AccentColor">#3D7EFF</Color>
    <Color x:Key="AccentHoverColor">#5B91FF</Color>
    <Color x:Key="AccentBlueColor">#3D7EFF</Color>
    <Color x:Key="StatusOnColor">#32DC5F</Color>
    <Color x:Key="StatusOffColor">#EB373C</Color>
    <Color x:Key="StatusMutedColor">#6F7278</Color>
    <Color x:Key="WarningColor">#C8C8CE</Color>
    <Color x:Key="TrafficCloseColor">#EB373C</Color>
    <Color x:Key="TrafficMinColor">#E6B84D</Color>
    <Color x:Key="TrafficMaxColor">#32DC5F</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="StatusOnBrush" Color="{StaticResource StatusOnColor}" />
    <SolidColorBrush x:Key="StatusOffBrush" Color="{StaticResource StatusOffColor}" />
    <SolidColorBrush x:Key="StatusMutedBrush" Color="{StaticResource StatusMutedColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusOnColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource StatusOffColor}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource StatusMutedColor}" />
    <SolidColorBrush x:Key="WindowControlBrush" Color="#3A3D44" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#5A5D64" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#EB373C" />
    <SolidColorBrush x:Key="TrafficCloseBrush" Color="{StaticResource TrafficCloseColor}" />
    <SolidColorBrush x:Key="TrafficMinBrush" Color="{StaticResource TrafficMinColor}" />
    <SolidColorBrush x:Key="TrafficMaxBrush" Color="{StaticResource TrafficMaxColor}" />

</ResourceDictionary>
