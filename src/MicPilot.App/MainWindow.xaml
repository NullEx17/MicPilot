<Window x:Class="MicPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:pages="clr-namespace:MicPilot.App.Views.Pages"
        Title="MicPilot"
        Width="920"
        Height="640"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/MicPilot;component/Assets/app/micpilot_on.ico"
        ResizeMode="CanResize"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootChrome"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left">
                        <Button x:Name="CloseButton"
                                Style="{StaticResource TrafficCloseStyle}"
                                Click="Close_Click"
                                ToolTip="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TrafficMinStyle}"
                                Click="Minimize_Click"
                                ToolTip="Minimize"
                                Margin="2,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource TrafficMaxStyle}"
                                Click="Maximize_Click"
                                ToolTip="Maximize"
                                Margin="2,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MicPilot;component/Assets/app/micpilot_on_16x16.png"
                               Width="16"
                               Height="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="MicPilot"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  |  No more Push-to-Talk."
                                   Style="{StaticResource DimTextStyle}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="MoreButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Style="{StaticResource IconButtonStyle}"
                            Width="32"
                            Height="32"
                            Click="More_Click"
                            ToolTip="Menu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource MoreGeometry}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="{StaticResource TextMutedBrush}" />
                    </Button>
                    <Popup x:Name="MorePopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=MoreButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                Width="168"
                                Margin="0,6,0,0">
                            <StackPanel>
                                <Button Content="Settings" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" Click="MoreSettings_Click" />
                                <Button Content="About" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" Click="MoreAbout_Click" />
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="6,4" />
                                <Button Content="Exit" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" Click="MoreExit_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16"
                        CornerRadius="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="10,12,10,4">
                            <TextBlock Text="MicPilot by NullEx17" Style="{StaticResource DimTextStyle}" FontSize="11" />
                            <TextBlock Text="v1.0.0" Style="{StaticResource DimTextStyle}" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel>
                            <RadioButton x:Name="NavHome"
                                         Content="Home"
                                         Tag="{StaticResource HomeGeometry}"
                                         Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav"
                                         IsChecked="True"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavGames"
                                         Content="Games &amp; Apps"
                                         Tag="{StaticResource GameGeometry}"
                                         Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettings"
                                         Content="Settings"
                                         Tag="{StaticResource SettingsGeometry}"
                                         Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavAbout"
                                         Content="About"
                                         Tag="{StaticResource InfoGeometry}"
                                         Style="{StaticResource NavButtonStyle}"
                                         GroupName="Nav"
                                         Checked="Nav_Checked" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <pages:HomeView x:Name="HomePage" />
                    <ContentControl x:Name="GamesHost" Visibility="Collapsed" />
                    <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />
                    <pages:AboutView x:Name="AboutPage" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
